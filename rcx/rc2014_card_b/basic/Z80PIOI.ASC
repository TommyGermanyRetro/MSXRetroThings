100 REM *************************
110 REM *** PIO via XIO/RCX   ***
120 REM *** IM2 TEST ROUTINE  ***
130 REM *** Uses SC103 as DUT ***
140 REM *************************
150 REM * Installs a Z80 ISR    *
160 REM * stub via IM2, then    *
170 REM * toggles PA0 and       *
180 REM * reports which PIO     *
190 REM * channel triggered     *
200 REM * the interrupt         *
210 REM *************************
220 REM * VERSION: 13/09/26     *
230 REM *************************
240 CLEAR 200,&HDFFF
250 DEFINT A, B, C, D
260 BB=0: BC=0: BD=0
265 C0=0:C1=0:C2=0:C3=0:C4=0:C5=0:C6=0:C7=0
270 A=0:B=0:C=0
280 CLS
290 REM *************************
300 REM *** Ask PIO IO addr   ***
310 REM *************************
320 INPUT "PIO card, IO address (0..252): ";BC
330 IF BC<0 OR BC>252 THEN PRINT "Please enter 0..252.":GOTO 320
340 REM *************************
350 REM *** Ask INT channel   ***
360 REM *************************
370 INPUT "IM2 channel (0..7): ";BB
380 IF BB<0 OR BB>7 THEN PRINT "Please enter 0..7.":GOTO 370
390 BD = BB + 8
400 REM *************************
410 REM *** XIO init          ***
420 REM *************************
430 _XIO ISINIT(A)
440 IF A=1 THEN _XIO DEINIT
450 _XIO INIT(A)
460 PRINT "[XIO] is installed"
470 REM *************************
480 REM *** RCX init          ***
490 REM *************************
500 _RCX ISINIT(D)
505 IF D=1 THEN _RCX DEINIT
510 _RCX INIT
520 REM *************************
530 REM *** PIO via SC103     ***
540 REM *************************
545 _PIO INIT(BC)
550 REM PORT A as OUTPUT
560 _PIO A CTRL(BC,&HF)
580 REM PORT A = 0
590 _PIO A WR(BC,0)
610 REM PORT B as MODE 3 and PB0 as Input
620 _PIO B CTRL(BC,&HCF)
640 _PIO B CTRL(BC,1)
650 REM PORT B INT-Vektor 0,2,4...14
660 BB = BB * 2
670 _PIO B CTRL(BC,BB)
680 REM PORT B INT-Controll via PB0
690 _PIO B CTRL(BC,&HB7)
700 _PIO B CTRL(BC,254)
710 REM *************************
720 REM *** Install ISR stub  ***
730 REM *************************
740 AD = &HE000
750 RESTORE 1540
760 READ A$
770 IF A$<>"END" THEN POKE AD,VAL("&H"+A$):AD=AD+1:GOTO 760
780 _XIO SET ADDR(BD,&HE000)
790 REM *************************
800 REM *** Interrupt mask    ***
810 REM *************************
820 REM IM2 &H00xx ... &HFFxx
830 C = &HFF00
840 _XIO SET MASK(C)
850 PRINT "[XIO] mask for IM2 is set to &H";:PRINT HEX$(C)
860 REM *************************
870 REM *** Main loop         ***
880 REM *************************
890 CLS
900 LOCATE 0,0
910 PRINT "<SPACE> ends programme, waiting for INT"
920 IF (A AND &H100) = &H100 THEN GOSUB 1190
930 IF (A AND &H200) = &H200 THEN GOSUB 1230
940 IF (A AND &H400) = &H400 THEN GOSUB 1270
950 IF (A AND &H800) = &H800 THEN GOSUB 1310
960 IF (A AND &H1000) = &H1000 THEN GOSUB 1350
970 IF (A AND &H2000) = &H2000 THEN GOSUB 1390
980 IF (A AND &H4000) = &H4000 THEN GOSUB 1430
990 IF (A AND &H8000) = &H8000 THEN GOSUB 1470
1000 REM Gebe 0/1 auf PORT A PA0 aus
1020 _PIO A WR(BC,B)
1030 REM Toggle Bit fuer PORT A PA0
1040 IF B=0 THEN B=1 ELSE B=0
1050 IF INKEY$ <>" " GOTO 920
1060 REM *************************
1070 REM *** End               ***
1080 REM *************************
1100 _PIO B CTRL(BC,&H07)
1110 _XIO SET MASK(0)
1120 _XIO SET ADDR(BD,0)
1130 _RCX DEINIT
1140 _XIO DEINIT
1145 LOCATE 0,6
1146 PRINT "DONE"
1150 END
1160 REM *************************
1170 REM *** Channel handlers  ***
1180 REM *************************
1190 LOCATE 0,2
1200 C0 = C0 + 1
1201 PRINT "Here channel 0, count: ";C0;"    "
1210 A = (A AND &HFE00)
1220 RETURN
1230 LOCATE 0,2
1240 C1 = C1 + 1
1241 PRINT "Here channel 1, count: ";C1;"    "
1250 A = (A AND &HFD00)
1260 RETURN
1270 LOCATE 0,2
1280 C2 = C2 + 1
1281 PRINT "Here channel 2, count: ";C2;"    "
1290 A = (A AND &HFB00)
1300 RETURN
1310 LOCATE 0,2
1320 C3 = C3 + 1
1321 PRINT "Here channel 3, count: ";C3;"    "
1330 A = (A AND &HF700)
1340 RETURN
1350 LOCATE 0,2
1360 C4 = C4 + 1
1361 PRINT "Here channel 4, count: ";C4;"    "
1370 A = (A AND &HEF00)
1380 RETURN
1390 LOCATE 0,2
1400 C5 = C5 + 1
1401 PRINT "Here channel 5, count: ";C5;"    "
1410 A = (A AND &HDF00)
1420 RETURN
1430 LOCATE 0,2
1440 C6 = C6 + 1
1441 PRINT "Here channel 6, count: ";C6;"    "
1450 A = (A AND &HBF00)
1460 RETURN
1470 LOCATE 0,2
1480 C7 = C7 + 1
1481 PRINT "Here channel 7, count: ";C7;"    "
1490 A = (A AND &H7F00)
1500 RETURN
1510 REM *************************
1520 REM *** Z80 ISR code      ***
1530 REM *************************
1540 DATA 3E,1B,CD,A2,00
1550 DATA 3E,59,CD,A2,00
1560 DATA 3E,24,CD,A2,00
1570 DATA 3E,20,CD,A2,00
1580 DATA 3E,20,CD,A2,00
1590 DATA 3E,20,CD,A2,00
1600 DATA 3E,20,CD,A2,00
1610 DATA 3E,20,CD,A2,00
1620 DATA 3E,20,CD,A2,00
1630 DATA 3E,20,CD,A2,00
1640 DATA 3E,20,CD,A2,00
1650 DATA 3E,20,CD,A2,00
1660 DATA 3E,20,CD,A2,00
1670 DATA 3E,20,CD,A2,00
1680 DATA 3E,20,CD,A2,00
1690 DATA 3E,20,CD,A2,00
1700 DATA 3E,20,CD,A2,00
1710 DATA 3E,1B,CD,A2,00
1720 DATA 3E,59,CD,A2,00
1730 DATA 3E,24,CD,A2,00
1740 DATA 3E,20,CD,A2,00
1750 DATA 3E,49,CD,A2,00
1760 DATA 3E,53,CD,A2,00
1770 DATA 3E,52,CD,A2,00
1780 DATA 3E,20,CD,A2,00
1790 DATA 3E,68,CD,A2,00
1800 DATA 3E,61,CD,A2,00
1810 DATA 3E,73,CD,A2,00
1820 DATA 3E,20,CD,A2,00
1830 DATA 3E,66,CD,A2,00
1840 DATA 3E,69,CD,A2,00
1850 DATA 3E,72,CD,A2,00
1860 DATA 3E,65,CD,A2,00
1870 DATA 3E,64,CD,A2,00
1880 DATA ED,4D,END
