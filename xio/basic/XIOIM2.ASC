100 REM *************************
110 REM *** IM2 TEST ROUTINE  ***
120 REM *** Uses SC103 as DUT ***
130 REM *************************
140 REM * Installs a Z80 ISR    *
150 REM * stub via IM2, then    *
160 REM * toggles PA0 and       *
170 REM * reports which PIO     *
180 REM * channel triggered     *
190 REM * the interrupt         *
200 REM *************************
210 REM * VERSION: 05/09/26     *
220 REM *************************
230 CLEAR 200,&HDFFF
240 DEFINT A, B, C
250 A=0:B=0:C=0
260 CLS
261 REM *************************
262 REM *** Ask PIO IO addr   ***
263 REM *************************
264 INPUT "PIO card, IO address (0..252): ";BC
265 IF BC<0 OR BC>252 THEN PRINT "Please enter 0..252.":GOTO 264
266 CA = BC + 2
267 CB = BC + 3
270 REM *************************
280 REM *** PIO via SC103     ***
290 REM *************************
300 REM PORT A as OUTPUT
310 _XIO OUT(CA,&HF)
320 REM PORT A = 0
330 _XIO OUT(BC,0)
340 REM PORT B as MODE 3 and PB0 as Input
350 _XIO OUT(CB,&HCF)
360 _XIO OUT(CB,1)
370 REM PORT B INT-Vektor 0,2,4...14
380 _XIO OUT(CB,0)
390 REM PORT B INT-Controll via PB0
400 _XIO OUT(CB,&HB7)
410 _XIO OUT(CB,254)
420 REM *************************
430 REM *** XIO init          ***
440 REM *************************
450 _XIO ISINIT(A)
460 IF A=1 THEN _XIO DEINIT
470 _XIO INIT(A)
480 PRINT "[XIO] is installed"
490 REM *************************
500 REM *** Install ISR stub  ***
510 REM *************************
520 AD = &HE000
530 RESTORE 1160
540 READ A$
550 IF A$<>"END" THEN POKE AD,VAL("&H"+A$):AD=AD+1:GOTO 540
560 _XIO SET ADDR(8,&HE000)
570 REM *************************
580 REM *** Interrupt mask    ***
590 REM *************************
600 REM IM2 &H00xx ... &HFFxx
610 C = &HFF00
620 _XIO SET MASK(C)
630 PRINT "[XIO] mask for IM2 is set to &H";:PRINT HEX$(C)
640 REM *************************
650 REM *** Main loop         ***
660 REM *************************
670 PRINT "<SPACE> ends programme, waiting for INT"
680 IF (A AND &H100) = &H100 THEN GOSUB 890
690 IF (A AND &H200) = &H200 THEN GOSUB 920
700 IF (A AND &H400) = &H400 THEN GOSUB 950
710 IF (A AND &H800) = &H800 THEN GOSUB 980
720 IF (A AND &H1000) = &H1000 THEN GOSUB 1010
730 IF (A AND &H2000) = &H2000 THEN GOSUB 1040
740 IF (A AND &H4000) = &H4000 THEN GOSUB 1070
750 IF (A AND &H8000) = &H8000 THEN GOSUB 1100
760 REM Gebe 0/1 auf PORT A PA0 aus
770 _XIO OUT(BC,B)
780 REM Toggle Bit fuer PORT A PA0
790 IF B=0 THEN B=1 ELSE B=0
800 IF INKEY$ <>" " GOTO 680
810 REM *************************
820 REM *** End               ***
830 REM *************************
840 _XIO DEINIT
850 END
860 REM *************************
870 REM *** Channel handlers  ***
880 REM *************************
890 PRINT "Here channel 0 ... <SPACE> ends programme, waiting for INT"
900 A = (A AND &HFE00)
910  RETURN
920 PRINT "Here channel 1 ... <SPACE> ends programme, waiting for INT"
930 A = (A AND &HFD00)
940 RETURN
950 PRINT "Here channel 2 ... <SPACE> ends programme, waiting for INT"
960 A = (A AND &HFB00)
970 RETURN
980 PRINT "Here channel 3 ... <SPACE> ends programme, waiting for INT"
990 A = (A AND &HF700)
1000 RETURN
1010 PRINT "Here channel 4 ... <SPACE> ends programme, waiting for INT"
1020 A = (A AND &HEF00)
1030 RETURN
1040 PRINT "Here channel 5 ... <SPACE> ends programme, waiting for INT"
1050 A = (A AND &HDF00)
1060 RETURN
1070 PRINT "Here channel 6 ... <SPACE> ends programme, waiting for INT"
1080 A = (A AND &HBF00)
1090 RETURN
1100 PRINT "Here channel 7 ... <SPACE> ends programme, waiting for INT"
1110 A = (A AND &H7F00)
1120 RETURN
1130 REM *************************
1140 REM *** Z80 ISR code      ***
1150 REM *************************
1160 DATA 3E,41,CD,A2,00
1170 DATA 3E,53,CD,A2,00
1180 DATA 3E,4D,CD,A2,00
1190 DATA 3E,20,CD,A2,00
1200 DATA 3E,43,CD,A2,00
1210 DATA 3E,68,CD,A2,00
1220 DATA 3E,3A,CD,A2,00
1230 DATA 3E,20,CD,A2,00
1240 DATA 3E,30,CD,A2,00
1250 DATA 3E,0A,CD,A2,00
1260 DATA 3E,0D,CD,A2,00
1270 DATA ED,4D,END
