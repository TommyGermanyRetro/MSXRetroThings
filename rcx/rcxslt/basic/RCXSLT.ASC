100 REM *************************
110 REM *** RCX SLOT WORK AREA***
120 REM *************************
130 REM * Dumps the 8-byte      *
140 REM * slot work area for    *
150 REM * a chosen slot, then   *
160 REM * follows the pointer   *
170 REM * stored at its bytes   *
180 REM * 6+7 and dumps &H60    *
190 REM * bytes from there      *
200 REM *************************
210 REM * VERSION: 13/09/26     *
220 REM *************************
230 INPUT  "Main slot number:" ;A$
240 S = VAL(A$)
250 REM *************************
260 REM *** Slot work area    ***
270 REM *************************
280 PRINT "Slot Work Area"
290 FOR I=(&HFD09+S*32) TO (&HFD09+S*32+7)
300 IF LEN(HEX$(PEEK(I)))=1 THEN PRINT "0"+HEX$(PEEK(I))+" ";
310 IF LEN(HEX$(PEEK(I)))=2 THEN PRINT     HEX$(PEEK(I))+" ";
320 NEXT
330 PRINT
340 REM *************************
350 REM *** Dump via ptr 6+7  ***
360 REM *************************
370 PRINT "Slot Work Area from Ptr Byte 6+7"
380 A=PEEK(&HFD09+S*32+6)+256*PEEK(&HFD09+S*32+7)
390 C=0
400 FOR B=A TO A+&H5F
410 IF LEN(HEX$(PEEK(B)))=1 THEN PRINT "0"+HEX$(PEEK(B))+" ";
420 IF LEN(HEX$(PEEK(B)))=2 THEN PRINT     HEX$(PEEK(B))+" ";
430 C=C+1
440 IF C=8 THEN C=0: PRINT
450 NEXT
