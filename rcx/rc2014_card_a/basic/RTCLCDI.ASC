100 REM *************************
110 REM *** SEED I2C LCD +    ***
120 REM *** PCF8583 RTC       ***
130 REM *************************
140 REM * Like RTCLCD, plus     *
150 REM * interrupt-driven LCD  *
160 REM * refresh: on each PIC  *
170 REM * channel interrupt the *
180 REM * RTC is re-read and    *
190 REM * the SEED LCD updated  *
200 REM *************************
210 REM * VERSION: 04/09/26     *
220 REM *************************
230 CLS
240 PRINT "I2C+RTC card type A"
250 REM *************************
260 REM *** Install XIO       ***
270 REM *************************
280 DEFINT A,B,C,D,E,G,M,N,Q,V,X
290 _XIO ISINIT(A)
300 IF A=1 THEN _XIO DEINIT
310 _XIO INIT(G)
320 REM *************************
330 REM *** Initialization    ***
340 REM *************************
350 _RCX ISINIT(A)
360 IF A=1 THEN _RCX DEINIT
370 _RCX INIT
380 T$="00:00:00" : DT$="01/01/00"
390 INPUT "I2C card, IO address (0..254): ";Q
395 IF Q<0 OR Q>254 THEN PRINT "Please enter 0..254.":GOTO 390
400 _I2C INIT(Q)
410 REM *************************
420 REM *** INT channel setup ***
430 REM *************************
440 INPUT "PIC INT channel (0..7): ";N
450 IF N<0 OR N>7 THEN PRINT "Please enter 0..7.":GOTO 440
460 M = 2^N
470 REM *************************
480 REM *** Read RTC          ***
490 REM *************************
500 _GET TIME(Q,T$)
510 _GET DATE(Q,DT$)
520 PRINT "Current date: ";DT$
530 PRINT "Current time: ";T$
540 REM *************************
550 REM *** Change date       ***
560 REM *************************
570 INPUT "Change date (Y/N)? ";Y$
580 IF LEN(Y$)<>1 OR (Y$<>"Y" AND Y$<>"y" AND Y$<>"N" AND Y$<>"n") THEN PRINT "Please enter Y or N.":GOTO 570
590 IF Y$="N" OR Y$="n" THEN GOTO 670
600 INPUT "New date (DD/MM/YY): ";DT2$
610 IF LEN(DT2$)<>8 THEN PRINT "Please enter exactly 8 characters.":GOTO 600
620 IF MID$(DT2$,3,1)<>"/" OR MID$(DT2$,6,1)<>"/" THEN PRINT "Format DD/MM/YY expected.":GOTO 600
630 V$=MID$(DT2$,1,2):GOSUB 1440:IF VOK=0 OR VVAL<1 OR VVAL>31 THEN PRINT "DD=01..31 expected.":GOTO 600
640 V$=MID$(DT2$,4,2):GOSUB 1440:IF VOK=0 OR VVAL<1 OR VVAL>12 THEN PRINT "MM=01..12 expected.":GOTO 600
650 V$=MID$(DT2$,7,2):GOSUB 1440:IF VOK=0 THEN PRINT "YY must be digits.":GOTO 600
660 DT$=DT2$ : _SET DATE(Q,DT$)
670 REM *************************
680 REM *** Change time       ***
690 REM *************************
700 INPUT "Change time (Y/N)? ";Y$
710 IF LEN(Y$)<>1 OR (Y$<>"Y" AND Y$<>"y" AND Y$<>"N" AND Y$<>"n") THEN PRINT "Please enter Y or N.":GOTO 700
720 IF Y$="N" OR Y$="n" THEN GOTO 800
730 INPUT "New time (HH:MM:SS): ";T2$
740 IF LEN(T2$)<>8 THEN PRINT "Please enter exactly 8 characters.":GOTO 730
750 IF MID$(T2$,3,1)<>":" OR MID$(T2$,6,1)<>":" THEN PRINT "Format HH:MM:SS expected.":GOTO 730
760 V$=MID$(T2$,1,2):GOSUB 1440:IF VOK=0 OR VVAL>23 THEN PRINT "HH=00..23 expected.":GOTO 730
770 V$=MID$(T2$,4,2):GOSUB 1440:IF VOK=0 OR VVAL>59 THEN PRINT "MM=00..59 expected.":GOTO 730
780 V$=MID$(T2$,7,2):GOSUB 1440:IF VOK=0 OR VVAL>59 THEN PRINT "SS=00..59 expected.":GOTO 730
790 T$=T2$ : _SET TIME(Q,T$)
800 REM *************************
810 REM *** SEED LCD sequence ***
820 REM *************************
830 A = &H7C
840 C = &H40
850 D = &H80
860 DIM B(20)
870 B(0)= D
880 B(1)=&H28
890 _I2C WRB(Q,A,2,B(0))
900 _I2C WRB(Q,A,2,B(0))
910 _I2C WRB(Q,A,2,B(0))
920 _I2C WRB(Q,A,2,B(0))
930 B(1)=&H1
940 _I2C WRB(Q,A,2,B(0))
950 B(1)=&HF
960 _I2C WRB(Q,A,2,B(0))
970 GOSUB 1130
980 PRINT "SEED LCD written with date and time"
990 REM *************************
1000 REM *** Main loop         ***
1010 REM *************************
1020 _XIO SET MASK(M)
1030 PRINT "<SPACE> ends programme, waiting for INT"
1040 IF (G AND M) = M THEN GOSUB 1360
1050 IF INKEY$ <> " " THEN GOTO 1040
1060 REM *************************
1070 REM *** End               ***
1080 REM *************************
1090 _XIO SET MASK(0)
1100 _XIO DEINIT
1110 _RCX DEINIT
1120 END
1130 REM *************************
1140 REM *** LCD line 1+2      ***
1150 REM *************************
1160 B(0)=D : B(1)=&H80
1170 _I2C WRB(Q,A,2,B(0))
1180 E = LEN(DT$)
1190 FOR F = 1 TO E
1200 B(F) = ASC(MID$(DT$,F))
1210 NEXT
1220 B(0) = C
1230 E = E + 1
1240 _I2C WRB(Q,A,E,B(0))
1250 B(0) = D
1260 B(1) = &HC0
1270 _I2C WRB(Q,A,2,B(0))
1280 E = LEN(T$)
1290 FOR F = 1 TO E
1300 B(F) = ASC(MID$(T$,F))
1310 NEXT
1320 B(0) = C
1330 E = E + 1
1340 _I2C WRB(Q,A,E,B(0))
1350 RETURN
1360 REM *************************
1370 REM *** Refresh on INT    ***
1380 REM *************************
1390 G = G AND (255-M)
1400 _GET TIME(Q,T$)
1410 _GET DATE(Q,DT$)
1420 GOSUB 1130
1430 RETURN
1440 REM *************************
1450 REM *** Subroutine DIGIT2 ***
1460 REM *************************
1470 REM Input: V$ (2 chars) - Output: VOK (1=valid), VVAL (value 0..99)
1480 VOK=0
1490 IF LEN(V$)<>2 THEN RETURN
1500 X1=ASC(MID$(V$,1,1)) : X2=ASC(MID$(V$,2,1))
1510 IF X1<48 OR X1>57 OR X2<48 OR X2>57 THEN RETURN
1520 VVAL=(X1-48)*10+X2-48 : VOK=1
1530 RETURN
