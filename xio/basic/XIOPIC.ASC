100 REM *************************
110 REM *** PIC TEST ROUTINE  ***
120 REM *************************
130 REM * Installs a Z80 ISR    *
140 REM * stub via the PIC      *
150 REM * channel 0-7 vector    *
160 REM * and reports which     *
170 REM * channel triggered     *
180 REM * the interrupt         *
190 REM *************************
200 REM * VERSION: 05/09/26     *
210 REM *************************
220 CLEAR 200,&HDFFF
230 DEFINT A, B
240 A=0:B=0:C=0
250 CLS
260 REM *************************
270 REM *** XIO init          ***
280 REM *************************
290 _XIO ISINIT(A)
300 IF A=1 THEN _XIO DEINIT
310 _XIO INIT(A)
320 PRINT "[XIO] is installed"
330 REM *************************
340 REM *** Install ISR stub  ***
350 REM *************************
360 AD = &HE000
370 RESTORE 960
380 READ A$
390 IF A$<>"END" THEN POKE AD,VAL("&H"+A$):AD=AD+1:GOTO 380
400 _XIO SET ADDR(0,&HE000)
410 REM *************************
420 REM *** Interrupt mask    ***
430 REM *************************
440 REM PIC &Hxx00 ... &HxxFF
450 B = &H1
460 _XIO SET MASK(B)
470 PRINT "[XIO] mask for PIC is set to &H";:PRINT HEX$(B)
480 REM *************************
490 REM *** Main loop         ***
500 REM *************************
510 PRINT "<SPACE> ends programme, waiting for INT"
520 IF (A AND &H1)   = &H1   THEN GOSUB 690
530 IF (A AND &H2)   = &H2   THEN GOSUB 720
540 IF (A AND &H4)   = &H4   THEN GOSUB 750
550 IF (A AND &H8)   = &H8   THEN GOSUB 780
560 IF (A AND &H10)   = &H10   THEN GOSUB 810
570 IF (A AND &H20)   = &H20   THEN GOSUB 840
580 IF (A AND &H40)   = &H40   THEN GOSUB 870
590 IF (A AND &H80)   = &H80   THEN GOSUB 900
600 IF INKEY$ <>" " GOTO 520
610 REM *************************
620 REM *** End               ***
630 REM *************************
640 _XIO DEINIT
650 END
660 REM *************************
670 REM *** Channel handlers  ***
680 REM *************************
690 PRINT "Here channel 0 ... <SPACE> ends programme, waiting for INT"
700 A = (A AND &HFE)
710  RETURN
720 PRINT "Here channel 1 ... <SPACE> ends programme, waiting for INT"
730 A = (A AND &HFD)
740 RETURN
750 PRINT "Here channel 2 ... <SPACE> ends programme, waiting for INT"
760 A = (A AND &HFB)
770 RETURN
780 PRINT "Here channel 3 ... <SPACE> ends programme, waiting for INT"
790 A = (A AND &HF7)
800 RETURN
810 PRINT "Here channel 4 ... <SPACE> ends programme, waiting for INT"
820 A = (A AND &HEF)
830 RETURN
840 PRINT "Here channel 5 ... <SPACE> ends programme, waiting for INT"
850 A = (A AND &HDF)
860 RETURN
870 PRINT "Here channel 6 ... <SPACE> ends programme, waiting for INT"
880 A = (A AND &HBF)
890 RETURN
900 PRINT "Here channel 7 ... <SPACE> ends programme, waiting for INT"
910 A = (A AND &H7F)
920 RETURN
930 REM *************************
940 REM *** Z80 ISR code      ***
950 REM *************************
960 DATA 3E,41,CD,A2,00
970 DATA 3E,53,CD,A2,00
980 DATA 3E,4D,CD,A2,00
990 DATA 3E,20,CD,A2,00
1000 DATA 3E,43,CD,A2,00
1010 DATA 3E,68,CD,A2,00
1020 DATA 3E,3A,CD,A2,00
1030 DATA 3E,20,CD,A2,00
1040 DATA 3E,30,CD,A2,00
1050 DATA 3E,0A,CD,A2,00
1060 DATA 3E,0D,CD,A2,00
1070 DATA C9,END
