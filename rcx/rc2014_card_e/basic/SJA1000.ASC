100 REM *************************
110 REM *** SJA1000 CAN TEST  ***
120 REM *************************
130 REM * RC2014 CAN card demo  *
140 REM * via SJA1000, plain    *
150 REM * BASIC only. Uses an   *
160 REM * acceptance code+mask  *
170 REM * filter, suits medium  *
180 REM * CAN traffic. Wired    *
190 REM * to CS3 (Maerklin)     *
200 REM *************************
210 REM * VERSION: 06/09/26     *
220 REM *************************
230 CLS
240 REM Variable usage:
250 REM A = Read Message Count
260 REM B(12) = CAN Message
270 REM C = FOR-NEXT-Index
280 REM D = INIT-Flag
290 REM E(7) = Acceptance code & mask
300 REM F = XIO Flag word (unused)
310 REM G(12) = CAN Message TX
320 REM M = INT-Mask (2^N)
330 REM N = INT-Channel
340 REM Q = CAN card IO address
350 REM R = TX Direction (0=Red,1=Green)
360 REM P = CAN INT Service Address
370 REM *************************
380 REM *** Check XIO         ***
390 REM *************************
400 DEFINT D,F,Q:D=0:F=0
410 _XIO ISINIT(D)
420 IF D>0 THEN _XIO DEINIT
430 _XIO INIT(F)
440 REM *************************
450 REM *** Check RCX         ***
460 REM *************************
470 D=0
480 _RCX ISINIT(D)
490 IF D>0 THEN _RCX DEINIT
500 _RCX INIT
510 REM *************************
520 REM *** Ask CAN IO address***
530 REM *************************
540 INPUT "CAN card, IO address (0..254): ";Q
550 IF Q<0 OR Q>254 THEN PRINT "Please enter 0..254.":GOTO 540
560 REM *************************
570 REM *** Dim variables     ***
580 REM *************************
590 DEFINT A,B,C,E,G,M,N,P,R:P=0:R=0
600 DIM B(12):DIM G(12)
610 DIM E(7)
620 RESTORE 1170
630 G(0)=&H86:G(1)=0:G(2)=&HB1:G(3)=&HDA:G(4)=&HE8:G(5)=0:G(6)=0
640 FOR C = 0 TO 7
650 READ E(C)
660 NEXT
670 REM *************************
680 REM *** Install SJA1000   ***
690 REM *************************
700 REM IO = Q, acceptance/mask = E(x)
710 _CAN INIT(Q,E(0))
720 REM *************************
730 REM *** Ask INT channel   ***
740 REM *************************
750 INPUT "PIC INT channel (0..7): ";N
760 IF N<0 OR N>7 THEN PRINT "Please enter 0..7.":GOTO 750
770 M = 2^N
780 CLS
790 LOCATE 0,9:PRINT "Key '1' starts the switching command sequence"
800 LOCATE 0,10:PRINT "ESC exits the programme"
810 REM *************************
820 REM *** Prepare CAN INT   ***
830 REM *************************
840 _CAN GET ADDR(Q,P)
850 _XIO SET ADDR(N,P)
860 _XIO SET MASK(M)
870 REM *************************
880 REM *** Main loop         ***
890 REM *************************
900 REM *************************
910 REM *** Check for new msg ***
920 REM *************************
930 _CAN CHECK(Q,A)
940 IF A>0 THEN GOSUB 1020
950 A$=INKEY$
960 IF A$=CHR$(27) THEN GOTO 1490
970 IF A$="1" THEN GOSUB 1210
980 GOTO 900
990 REM *************************
1000 REM *** Show RX message   ***
1010 REM *************************
1020 LOCATE 0,0
1030 PRINT"RX: "
1040 LOCATE 4,0
1050 _CAN RX(Q,B(0))
1060 FOR C=0 TO 12
1070 IF B(C)<16 THEN PRINT "0";:
1080 PRINT HEX$(B(C));:PRINT" ";
1090 NEXT
1100 PRINT
1110 RETURN
1120 REM *************************
1130 REM *** Accept code+mask  ***
1140 REM *************************
1150 REM ACR.0,ACR.1,ACR.2,ACR.3
1160 REM AMR.0,AMR.1,AMR.2,AMR.3
1170 DATA &HF0,&HB7,&HFF,&HFF,&HF0,&H07,&HFF,&HFF
1180 REM *************************
1190 REM *** Send test message ***
1200 REM *************************
1210 LOCATE 0,3
1220 PRINT"                             "
1230 LOCATE 0,3
1240 INPUT"ADDR (3000...33ff):";A$
1250 B$="&H"+LEFT$(A$,4)
1260 C=VAL(B$)
1270 IF C<&H3000 OR C>&H33FF THEN PRINT "Please enter 3000..33FF.":GOTO 1210
1280 LOCATE 0,4
1290 PRINT"                             "
1300 LOCATE 0,4
1310 INPUT"DIR (0=Red,1=Green):";A$
1320 A$="&H"+Left$(A$,1)
1330 R=VAL(A$)
1340 IF R<>0 AND R<>1 THEN PRINT "Please enter 0 or 1.":GOTO 1280
1350 LOCATE 0,5
1360 PRINT"                             "
1370 G(0)=&H86:G(1)=0:G(2)=&HB1:G(3)=&HDA:G(4)=&HE8:G(5)=0:G(6)=0
1380 G(7)=C/256
1390 G(8)=(C AND &HF)
1400 G(9)=R
1410 G(10)=1
1420 _CAN TX(Q,G(0))
1430 G(10)=0
1440 _CAN TX(Q,G(0))
1450 RETURN
1460 REM *************************
1470 REM *** End               ***
1480 REM *************************
1490 _XIO DEINIT
1500 _RCX DEINIT
1510 CLS
1520 END
