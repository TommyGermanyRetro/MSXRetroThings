100 REM *************************
110 REM *** 8254 TIMER TEST   ***
120 REM *** INTERRUPT VARIANT ***
130 REM *************************
140 REM * Like 8254, but        *
150 REM * TIMER1's OUT is wired *
160 REM * externally not just to*
170 REM * CLK2 but also to a PIC*
180 REM * channel. TIMER2 is    *
190 REM * still read/printed    *
200 REM * continuously in the   *
210 REM * loop, like plain 8254 *
220 REM * - but on every PIC    *
230 REM * interrupt (from       *
240 REM * TIMER1) 'TIMER1       *
250 REM * fired', plus a running*
260 REM * interrupt count, is   *
270 REM * also shown, staying   *
280 REM * visible until the next*
290 REM * interrupt. Uses LOCATE*
300 REM * for both so the screen*
310 REM * never scrolls.        *
320 REM *************************
330 REM * VERSION: 09/09/26     *
340 REM *************************
350 CLS
360 DEFINT A,B,G,I,M,N,Q
370 I = 0
380 REM *************************
390 REM *** Install XIO       ***
400 REM *************************
410 _XIO ISINIT(A)
420 IF A=1 THEN _XIO DEINIT
430 _XIO INIT(G)
440 REM *************************
450 REM *** Initialization    ***
460 REM *************************
470 _RCX ISINIT(A)
480 IF A=1 THEN _RCX DEINIT
490 _RCX INIT
500 REM *************************
510 REM *** Ask timer IO addr ***
520 REM *************************
530 INPUT "Timer card, IO address (0..251): ";Q
540 IF Q<0 OR Q>251 THEN PRINT "Please enter 0..251.":GOTO 530
550 _TIMER INIT(Q)
560 REM *************************
570 REM *** Ask INT channel   ***
580 REM *************************
590 INPUT "PIC INT channel (0..7): ";N
600 IF N<0 OR N>7 THEN PRINT "Please enter 0..7.":GOTO 590
610 M = 2^N
620 REM *************************
630 REM *** Timer setup       ***
640 REM *************************
650 _TIMER CTRL(Q,&H34)
660 _TIMER CTRL(Q,&H74)
670 _TIMER RES GATE(Q,7)
680 _TIMER 0 WR(Q,&HFFFF)
690 _TIMER 1 WR(Q,16)
700 _TIMER 2 WR(Q,&HFFFF)
710 _TIMER SET GATE(Q,7)
720 REM *************************
730 REM *** Main loop         ***
740 REM *************************
750 _XIO SET MASK(M)
760 CLS
770 LOCATE 0,0
780 PRINT "<SPACE> ends programme, waiting for INT"
790 _TIMER 2 RD(Q,A)
800 LOCATE 0,2
810 PRINT "TIMER2: ";HEX$(A);"      "
820 IF (G AND M) = M THEN GOSUB 950
830 IF INKEY$ <> " " THEN GOTO 790
840 REM *************************
850 REM *** End               ***
860 REM *************************
870 LOCATE 0,6
880 _XIO SET MASK(0)
890 _XIO DEINIT
900 _RCX DEINIT
910 END
920 REM *************************
930 REM *** On PIC interrupt  ***
940 REM *************************
950 G = G AND (255-M)
960 I = I + 1
970 LOCATE 0,4
980 PRINT "TIMER1 fired  count=";I;"   "
990 RETURN
