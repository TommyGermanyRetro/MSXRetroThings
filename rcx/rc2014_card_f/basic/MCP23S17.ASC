100 REM *************************
110 REM *** SPI via XIO/RCX   ***
120 REM *************************
130 REM * Uses RCX library SPI  *
140 REM * calls. MCP23S17 with  *
150 REM * GPIO A as output and  *
160 REM * GPIO B as input       *
170 REM *************************
180 REM * VERSION: 01/09/26     *
190 REM *************************
200 CLS
210 DEFINT A,B,C,D,E,F,G,H,I,J,K,L,Q
211 REM *************************
212 REM *** Ask SPI IO addr   ***
213 REM *************************
214 INPUT "SPI card, IO address (0..252): ";Q
215 IF Q<0 OR Q>252 THEN PRINT "Please enter 0..252.":GOTO 214
220 DIM K(3)
230 REM *************************
240 REM *** Initialization    ***
250 REM *************************
260 _RCX ISINIT(A)
270 IF A=1 THEN _RCX DEINIT
280 _RCX INIT
290 REM *************************
300 REM *** MCP23S17 registers***
310 REM *************************
320 J=0
330 A=&H40:   REM MCP SPI command byte (write)
340 B=&H0:    REM IODIRA
350 C=&H1:    REM IODIRB
360 D=&H12:   REM GPIOA
370 E=&H13:   REM GPIOB
380 F=&H14:   REM OLATA
390 G=&H15:   REM OLATB
400 H=&HA:    REM IOCON
410 REM *************************
420 REM *** SPI init          ***
430 REM *************************
440 _SPI INIT(Q)
450 _SPI MODE(Q,0,0,0)
460 REM *************************
470 REM *** Set IODIR A/B     ***
480 REM *************************
490 K(0) = A: K(1) = B: K(2) = 0
500 _SPI WRB(Q,0,3,K(0))
510 K(0) = A: K(1) = C: K(2) = &HFF
520 _SPI WRB(Q,0,3,K(0))
530 REM *************************
540 REM *** Main loop         ***
550 REM *************************
560 K(0) = A: K(1) = D: K(2) = J
570 _SPI WRB(Q,0,3,K(0))
580 K(0) = A+1: K(1) = E: K(2) = 0
590 _SPI RDH(Q,0,2,1,K(0))
600 I = K(2)
610 PRINT"OUT: ",HEX$(J),"IN: ",HEX$(I)
620 J=J+1
630 IF J=256 THEN J=0
640 GOTO 560
