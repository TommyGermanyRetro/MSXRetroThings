100 REM *************************
110 REM *** MCP4822 RCX TEST  ***
120 REM *************************
130 REM * RC2014 card I with 2x *
140 REM * MCP4822 (4 channels   *
150 REM * 12 bit D/A) - RCX     *
160 REM * card type I. Uses     *
170 REM * _DAC INIT/SET/HOLD/   *
180 REM * CONF/GET. Checks the  *
190 REM * value readback, sets  *
200 REM * synchronous test      *
210 REM * voltages, gain x1,    *
220 REM * shutdown and then     *
230 REM * single channels by    *
240 REM * keyboard input.       *
250 REM *************************
260 REM * VERSION: 02/11/26     *
270 REM *************************
280 CLS
290 REM *************************
300 REM *** Variables         ***
310 REM *************************
320 REM Q     = card IO address
330 REM K     = channel 0..3
340 REM V     = value 0..4095 (gain x2 = mV)
350 REM R     = DAC GET readback value
360 REM I     = loop counter
370 REM ER    = readback mismatch counter
380 REM A     = _RCX ISINIT flag
390 REM A$    = key press
400 DEFINT A-Z
410 REM *************************
420 REM *** Ask card IO addr  ***
430 REM *************************
440 INPUT "MCP4822 card, IO address (0..252): ";Q
450 IF Q<0 OR Q>252 OR (Q AND 3)<>0 THEN PRINT "Please enter 0..252, multiple of 4.":GOTO 440
460 REM *************************
470 REM *** Setup             ***
480 REM *************************
490 ER=0:R=0:A=0
500 REM *************************
510 REM *** Install RCX+DAC   ***
520 REM *************************
530 _RCX ISINIT(A)
540 IF A=1 THEN _RCX DEINIT
550 _RCX INIT
560 _DAC INIT(Q)
570 REM *************************
580 REM *** Test A: SET/GET   ***
590 REM *************************
600 REM DAC SET + DAC GET 0..4095 per channel
610 FOR K=0 TO 3
620  FOR I=0 TO 3
630   V=I*1365
640   _DAC SET(Q,K,V)
650   _DAC GET(Q,K,R)
660   IF R<>V THEN ER=ER+1:PRINT"FAIL A ch";K;" value";V;" read";R
670  NEXT
680 NEXT
690 PRINT"Test A (SET/GET readback) done"
700 REM *************************
710 REM *** Test B: HOLD/GET  ***
720 REM *************************
730 REM DAC HOLD + DAC GET (HOLD bit not read)
740 FOR K=0 TO 3
750  V=4095-K*1000
760  _DAC HOLD(Q,K,V)
770  _DAC GET(Q,K,R)
780  IF R<>V THEN ER=ER+1:PRINT"FAIL B ch";K;" value";V;" read";R
790 NEXT
800 PRINT"Test B (HOLD/GET readback) done"
810 PRINT
820 REM *************************
830 REM *** Test C: sync      ***
840 REM *************************
850 REM all 0 V, then 1/2/3 V with HOLD,
860 REM channel 3 with SET = all outputs
870 FOR K=0 TO 3
880  _DAC SET(Q,K,0)
890 NEXT
900 FOR K=0 TO 2
910  V=(K+1)*1000
920  _DAC HOLD(Q,K,V)
930 NEXT
940 PRINT"X101.2-5 must still be 0 V (HOLD)."
950 PRINT"Press a key.":A$=INPUT$(1)
960 _DAC SET(Q,3,4000)
970 PRINT"X101.2-5 now 1.000/2.000/3.000/4.000 V."
980 PRINT"Press a key.":A$=INPUT$(1)
990 PRINT
1000 REM *************************
1010 REM *** Test D: gain+shdn ***
1020 REM *************************
1030 REM channel 0 (1000) gain x1 -> 0.5 V,
1040 REM shutdown -> 0 V, back to gain x2
1050 _DAC CONF(Q,0,0)
1060 PRINT"Gain x1: X101.2 must be 0.500 V."
1070 PRINT"Press a key.":A$=INPUT$(1)
1080 _DAC CONF(Q,0,3)
1090 PRINT"Shutdown: X101.2 must be 0 V."
1100 PRINT"Press a key.":A$=INPUT$(1)
1110 _DAC CONF(Q,0,1)
1120 PRINT"Gain x2: X101.2 must be 1.000 V again."
1130 PRINT
1140 REM *************************
1150 REM *** Summary           ***
1160 REM *************************
1170 IF ER=0 THEN PRINT"ALL READBACK CHECKS PASSED" ELSE PRINT ER;"READBACK ERRORS"
1180 PRINT
1190 REM *************************
1200 REM *** Manual output     ***
1210 REM *************************
1220 INPUT "Channel 0..3 (9 = end)";K
1230 IF K=9 THEN END
1240 IF K<0 OR K>3 THEN 1220
1250 INPUT "Value 0..4095 (mV)";V
1260 IF V<0 OR V>4095 THEN 1250
1270 _DAC SET(Q,K,V)
1280 GOTO 1220
