100 REM *************************
110 REM *** 8254 TIMER TEST   ***
120 REM *************************
130 REM * TIMER0 and TIMER1 both*
140 REM * MODE 2 (Rate          *
150 REM * Generator), gated     *
160 REM * always. TIMER0 preset *
170 REM * to 0xFFFF, TIMER1     *
180 REM * preset to 4. TIMER2   *
190 REM * (MODE 0, gated always)*
200 REM * preset to 0xFFFF. OUT *
210 REM * of TIMER0 wired       *
220 REM * externally to CLK of  *
230 REM * TIMER1, and OUT1 to   *
231 REM * CLK2. Reads TIMER2    *
240 REM * back in a loop.       *
250 REM *************************
260 REM * VERSION: 09/09/26     *
270 REM *************************
280 CLS
290 DEFINT A,B,Q
300 REM *************************
310 REM *** Initialization    ***
320 REM *************************
330 _RCX ISINIT(A)
340 IF A=1 THEN _RCX DEINIT
350 _RCX INIT
360 REM *************************
370 REM *** Ask timer IO addr ***
380 REM *************************
390 INPUT "Timer card, IO address (0..251): ";Q
400 IF Q<0 OR Q>251 THEN PRINT "Please enter 0..251.":GOTO 390
410 _TIMER INIT(Q)
420 REM *************************
430 REM *** Timer setup       ***
440 REM *************************
450 _TIMER CTRL(Q,&H34)
460 _TIMER CTRL(Q,&H74)
470 _TIMER RES GATE(Q,7)
480 _TIMER 0 WR(Q,&HFFFF)
490 _TIMER 1 WR(Q,16)
500 _TIMER 2 WR(Q,&HFFFF)
510 _TIMER SET GATE(Q,7)
520 REM *************************
530 REM *** Main loop         ***
540 REM *************************
550 _TIMER 2 RD(Q,A)
560 PRINT HEX$(A)
570 GOTO 550
