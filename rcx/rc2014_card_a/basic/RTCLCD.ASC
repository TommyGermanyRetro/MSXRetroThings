100 REM *************************
110 REM *** SEED I2C LCD +    ***
120 REM *** PCF8583 RTC       ***
130 REM *************************
140 REM * Reads RTC date/time,  *
150 REM * optionally lets user  *
160 REM * change them, then     *
170 REM * shows both on the     *
180 REM * SEED I2C LCD display  *
190 REM *************************
200 REM * VERSION: 04/09/26     *
210 REM *************************
220 CLS
230 PRINT "I2C+RTC card type A"
240 REM *************************
250 REM *** Initialization    ***
260 REM *************************
270 DEFINT A,B,C,D,E,Q,V,X
280 _RCX ISINIT(A)
290 IF A=1 THEN _RCX DEINIT
300 _RCX INIT
310 T$="00:00:00" : DT$="01/01/00"
320 INPUT "I2C card, IO address (0..254): ";Q
325 IF Q<0 OR Q>254 THEN PRINT "Please enter 0..254.":GOTO 320
330 _I2C INIT(Q)
340 REM *************************
350 REM *** Read RTC          ***
360 REM *************************
370 _GET TIME(Q,T$)
380 _GET DATE(Q,DT$)
390 PRINT "Current date: ";DT$
400 PRINT "Current time: ";T$
410 REM *************************
420 REM *** Change date       ***
430 REM *************************
440 INPUT "Change date (Y/N)? ";Y$
450 IF LEN(Y$)<>1 OR (Y$<>"Y" AND Y$<>"y" AND Y$<>"N" AND Y$<>"n") THEN PRINT "Please enter Y or N.":GOTO 440
460 IF Y$="N" OR Y$="n" THEN GOTO 540
470 INPUT "New date (DD/MM/YY): ";DT2$
480 IF LEN(DT2$)<>8 THEN PRINT "Please enter exactly 8 characters.":GOTO 470
490 IF MID$(DT2$,3,1)<>"/" OR MID$(DT2$,6,1)<>"/" THEN PRINT "Format DD/MM/YY expected.":GOTO 470
500 V$=MID$(DT2$,1,2):GOSUB 1160:IF VOK=0 OR VVAL<1 OR VVAL>31 THEN PRINT "DD=01..31 expected.":GOTO 470
510 V$=MID$(DT2$,4,2):GOSUB 1160:IF VOK=0 OR VVAL<1 OR VVAL>12 THEN PRINT "MM=01..12 expected.":GOTO 470
520 V$=MID$(DT2$,7,2):GOSUB 1160:IF VOK=0 THEN PRINT "YY must be digits.":GOTO 470
530 DT$=DT2$ : _SET DATE(Q,DT$)
540 REM *************************
550 REM *** Change time       ***
560 REM *************************
570 INPUT "Change time (Y/N)? ";Y$
580 IF LEN(Y$)<>1 OR (Y$<>"Y" AND Y$<>"y" AND Y$<>"N" AND Y$<>"n") THEN PRINT "Please enter Y or N.":GOTO 570
590 IF Y$="N" OR Y$="n" THEN GOTO 670
600 INPUT "New time (HH:MM:SS): ";T2$
610 IF LEN(T2$)<>8 THEN PRINT "Please enter exactly 8 characters.":GOTO 600
620 IF MID$(T2$,3,1)<>":" OR MID$(T2$,6,1)<>":" THEN PRINT "Format HH:MM:SS expected.":GOTO 600
630 V$=MID$(T2$,1,2):GOSUB 1160:IF VOK=0 OR VVAL>23 THEN PRINT "HH=00..23 expected.":GOTO 600
640 V$=MID$(T2$,4,2):GOSUB 1160:IF VOK=0 OR VVAL>59 THEN PRINT "MM=00..59 expected.":GOTO 600
650 V$=MID$(T2$,7,2):GOSUB 1160:IF VOK=0 OR VVAL>59 THEN PRINT "SS=00..59 expected.":GOTO 600
660 T$=T2$ : _SET TIME(Q,T$)
670 REM *************************
680 REM *** SEED LCD sequence ***
690 REM *************************
700 PRINT "Initializing SEED LCD"
710 A = &H7C
720 C = &H40
730 D = &H80
740 DIM B(20)
750 B(0)= D
760 B(1)=&H28
770 _I2C WRB(Q,A,2,B(0))
780 _I2C WRB(Q,A,2,B(0))
790 _I2C WRB(Q,A,2,B(0))
800 _I2C WRB(Q,A,2,B(0))
810 B(1)=&H1
820 _I2C WRB(Q,A,2,B(0))
830 B(1)=&HF
840 _I2C WRB(Q,A,2,B(0))
850 REM --- Line 1: date ---
860 B(1)=&H80
870 _I2C WRB(Q,A,2,B(0))
880 E = LEN(DT$)
890 FOR F = 1 TO E
900 B(F) = ASC(MID$(DT$,F))
910 NEXT
920 B(0) = C
930 E = E + 1
940 _I2C WRB(Q,A,E,B(0))
950 REM --- Line 2: time ---
960 B(0) = D
970 B(1) = &HC0
980 _I2C WRB(Q,A,2,B(0))
990 E = LEN(T$)
1000 FOR F = 1 TO E
1010 B(F) = ASC(MID$(T$,F))
1020 NEXT
1030 B(0) = C
1040 E = E + 1
1050 _I2C WRB(Q,A,E,B(0))
1060 PRINT "SEED LCD written with date and time"
1070 REM *************************
1080 REM *** End               ***
1090 REM *************************
1100 _RCX DEINIT
1110 END
1120 REM *************************
1130 REM *** Subroutine DIGIT2 ***
1140 REM *************************
1150 REM Input: V$ (2 chars) - Output: VOK (1=valid), VVAL (value 0..99)
1160 VOK=0
1170 IF LEN(V$)<>2 THEN RETURN
1180 X1=ASC(MID$(V$,1,1)) : X2=ASC(MID$(V$,2,1))
1190 IF X1<48 OR X1>57 OR X2<48 OR X2>57 THEN RETURN
1200 VVAL=(X1-48)*10+X2-48 : VOK=1
1210 RETURN
