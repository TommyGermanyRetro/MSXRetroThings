100 REM *************************
110 REM *** PIC TEST ROUTINE  ***
120 REM *************************
130 REM * Installs a Z80 ISR    *
140 REM * stub on PIC channel 0 *
150 REM * and enables all 8 PIC *
160 REM * channels (0-7) via    *
170 REM * SET MASK, reporting   *
180 REM * whichever fires       *
190 REM *************************
200 REM * VERSION: 13/09/26     *
210 REM *************************
220 CLEAR 200,&HDFFF
230 DEFINT A, B, C
240 C0=0:C1=0:C2=0:C3=0:C4=0:C5=0:C6=0:C7=0
250 A=0:B=0:C=0
260 CLS
270 REM *************************
280 REM *** XIO init          ***
290 REM *************************
300 _XIO ISINIT(A)
310 IF A=1 THEN _XIO DEINIT
320 _XIO INIT(A)
330 PRINT "[XIO] is installed"
340 REM *************************
350 REM *** Install ISR stub  ***
360 REM *************************
370 AD = &HE000
380 RESTORE 1170
390 READ A$
400 IF A$<>"END" THEN POKE AD,VAL("&H"+A$):AD=AD+1:GOTO 390
410 _XIO SET ADDR(0,&HE000)
420 REM *************************
430 REM *** Interrupt mask    ***
440 REM *************************
450 REM PIC &Hxx00 ... &HxxFF
460 B = &HFF
470 _XIO SET MASK(B)
480 PRINT "[XIO] mask for PIC is set to &H";:PRINT HEX$(B)
490 REM *************************
500 REM *** Main loop         ***
510 REM *************************
520 CLS
530 LOCATE 0,0
540 PRINT "<SPACE> ends programme, waiting for INT"
550 IF (A AND &H1) = &H1 THEN GOSUB 740
560 IF (A AND &H2) = &H2 THEN GOSUB 790
570 IF (A AND &H4) = &H4 THEN GOSUB 840
580 IF (A AND &H8) = &H8 THEN GOSUB 890
590 IF (A AND &H10) = &H10 THEN GOSUB 940
600 IF (A AND &H20) = &H20 THEN GOSUB 990
610 IF (A AND &H40) = &H40 THEN GOSUB 1040
620 IF (A AND &H80) = &H80 THEN GOSUB 1090
630 IF INKEY$ <>" " GOTO 550
640 REM *************************
650 REM *** End               ***
660 REM *************************
670 _XIO DEINIT
680 LOCATE 0,6
690 PRINT "DONE"
700 END
710 REM *************************
720 REM *** Channel handlers  ***
730 REM *************************
740 LOCATE 0,2
750 C0 = C0 + 1
760 PRINT "Here channel 0, count: ";C0;"    "
770 A = (A AND &HFE)
780 RETURN
790 LOCATE 0,2
800 C1 = C1 + 1
810 PRINT "Here channel 1, count: ";C1;"    "
820 A = (A AND &HFD)
830 RETURN
840 LOCATE 0,2
850 C2 = C2 + 1
860 PRINT "Here channel 2, count: ";C2;"    "
870 A = (A AND &HFB)
880 RETURN
890 LOCATE 0,2
900 C3 = C3 + 1
910 PRINT "Here channel 3, count: ";C3;"    "
920 A = (A AND &HF7)
930 RETURN
940 LOCATE 0,2
950 C4 = C4 + 1
960 PRINT "Here channel 4, count: ";C4;"    "
970 A = (A AND &HEF)
980 RETURN
990 LOCATE 0,2
1000 C5 = C5 + 1
1010 PRINT "Here channel 5, count: ";C5;"    "
1020 A = (A AND &HDF)
1030 RETURN
1040 LOCATE 0,2
1050 C6 = C6 + 1
1060 PRINT "Here channel 6, count: ";C6;"    "
1070 A = (A AND &HBF)
1080 RETURN
1090 LOCATE 0,2
1100 C7 = C7 + 1
1110 PRINT "Here channel 7, count: ";C7;"    "
1120 A = (A AND &H7F)
1130 RETURN
1140 REM *************************
1150 REM *** Z80 ISR code      ***
1160 REM *************************
1170 DATA 3E,1B,CD,A2,00
1180 DATA 3E,59,CD,A2,00
1190 DATA 3E,24,CD,A2,00
1200 DATA 3E,20,CD,A2,00
1210 DATA 3E,20,CD,A2,00
1220 DATA 3E,20,CD,A2,00
1230 DATA 3E,20,CD,A2,00
1240 DATA 3E,20,CD,A2,00
1250 DATA 3E,20,CD,A2,00
1260 DATA 3E,20,CD,A2,00
1270 DATA 3E,20,CD,A2,00
1280 DATA 3E,20,CD,A2,00
1290 DATA 3E,20,CD,A2,00
1300 DATA 3E,20,CD,A2,00
1310 DATA 3E,20,CD,A2,00
1320 DATA 3E,20,CD,A2,00
1330 DATA 3E,20,CD,A2,00
1340 DATA 3E,1B,CD,A2,00
1350 DATA 3E,59,CD,A2,00
1360 DATA 3E,24,CD,A2,00
1370 DATA 3E,20,CD,A2,00
1380 DATA 3E,49,CD,A2,00
1390 DATA 3E,53,CD,A2,00
1400 DATA 3E,52,CD,A2,00
1410 DATA 3E,20,CD,A2,00
1420 DATA 3E,68,CD,A2,00
1430 DATA 3E,61,CD,A2,00
1440 DATA 3E,73,CD,A2,00
1450 DATA 3E,20,CD,A2,00
1460 DATA 3E,66,CD,A2,00
1470 DATA 3E,69,CD,A2,00
1480 DATA 3E,72,CD,A2,00
1490 DATA 3E,65,CD,A2,00
1500 DATA 3E,64,CD,A2,00
1510 DATA C9,END
