<?xml version="1.0" encoding="utf-8"?>
<!-- Settings of the SVI328 solution: the machine on top of the shared expanders, cards and chips. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <SolutionRoot>$(MSBuildThisFileDirectory)</SolutionRoot>
    <BuildRoot>$(MSBuildThisFileDirectory)..\Build\</BuildRoot>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)..\..\svi3x8\Common.props" />
  <PropertyGroup>
    <Svi328Include>$(SolutionRoot)SVI328\include</Svi328Include>
  </PropertyGroup>
</Project>
