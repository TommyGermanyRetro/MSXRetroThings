100 REM *************************
110 REM *** IM2 TEST ROUTINE  ***
120 REM *** Uses SC103 as DUT ***
130 REM *************************
140 REM * Installs a Z80 ISR    *
150 REM * stub via IM2, then    *
160 REM * toggles PA0 and       *
170 REM * reports which PIO     *
180 REM * channel triggered     *
190 REM * the interrupt         *
200 REM *************************
210 REM * VERSION: 13/09/26     *
220 REM *************************
230 CLEAR 200,&HDFFF
240 DEFINT A, B, C
250 C0=0:C1=0:C2=0:C3=0:C4=0:C5=0:C6=0:C7=0
260 A=0:B=0:C=0
270 CLS
280 REM *************************
290 REM *** Ask PIO IO addr   ***
300 REM *************************
310 INPUT "PIO card, IO address (0..252): ";BC
320 IF BC<0 OR BC>252 THEN PRINT "Please enter 0..252.":GOTO 310
330 CA = BC + 2
340 CB = BC + 3
350 REM *************************
360 REM *** Ask INT channel   ***
370 REM *************************
380 INPUT "IM2 channel (0..7): ";BB
390 IF BB<0 OR BB>7 THEN PRINT "Please enter 0..7.":GOTO 380
400 BD = BB + 8
410 REM *************************
420 REM *** PIO via SC103     ***
430 REM *************************
440 REM PORT A as OUTPUT
450 _XIO OUT(CA,&HF)
460 REM PORT A = 0
470 _XIO OUT(BC,0)
480 REM PORT B as MODE 3 and PB0 as Input
490 _XIO OUT(CB,&HCF)
500 _XIO OUT(CB,1)
510 REM PORT B INT-Vektor 0,2,4...14
515 BB = BB * 2
520 _XIO OUT(CB,BB)
530 REM PORT B INT-Controll via PB0
540 _XIO OUT(CB,&HB7)
550 _XIO OUT(CB,254)
560 REM *************************
570 REM *** XIO init          ***
580 REM *************************
590 _XIO ISINIT(A)
600 IF A=1 THEN _XIO DEINIT
610 _XIO INIT(A)
620 PRINT "[XIO] is installed"
630 REM *************************
640 REM *** Install ISR stub  ***
650 REM *************************
660 AD = &HE000
670 RESTORE 1520
680 READ A$
690 IF A$<>"END" THEN POKE AD,VAL("&H"+A$):AD=AD+1:GOTO 680
700 _XIO SET ADDR(BD,&HE000)
710 REM *************************
720 REM *** Interrupt mask    ***
730 REM *************************
740 REM IM2 &H00xx ... &HFFxx
750 C = &HFF00
760 _XIO SET MASK(C)
770 PRINT "[XIO] mask for IM2 is set to &H";:PRINT HEX$(C)
780 REM *************************
790 REM *** Main loop         ***
800 REM *************************
810 CLS
820 LOCATE 0,0
830 PRINT "<SPACE> ends programme, waiting for INT"
840 IF (A AND &H100) = &H100 THEN GOSUB 1090
850 IF (A AND &H200) = &H200 THEN GOSUB 1140
860 IF (A AND &H400) = &H400 THEN GOSUB 1190
870 IF (A AND &H800) = &H800 THEN GOSUB 1240
880 IF (A AND &H1000) = &H1000 THEN GOSUB 1290
890 IF (A AND &H2000) = &H2000 THEN GOSUB 1340
900 IF (A AND &H4000) = &H4000 THEN GOSUB 1390
910 IF (A AND &H8000) = &H8000 THEN GOSUB 1440
920 REM Gebe 0/1 auf PORT A PA0 aus
930 _XIO OUT(BC,B)
940 REM Toggle Bit fuer PORT A PA0
950 IF B=0 THEN B=1 ELSE B=0
960 IF INKEY$ <>" " GOTO 840
970 REM *************************
980 REM *** End               ***
990 REM *************************
1000 _XIO SET MASK(0)
1010 _XIO SET ADDR(BD,0)
1020 _XIO DEINIT
1030 LOCATE 0,6
1040 PRINT "DONE"
1050 END
1060 REM *************************
1070 REM *** Channel handlers  ***
1080 REM *************************
1090 LOCATE 0,2
1100 C0 = C0 + 1
1110 PRINT "Here channel 0, count: ";C0;"    "
1120 A = (A AND &HFE00)
1130 RETURN
1140 LOCATE 0,2
1150 C1 = C1 + 1
1160 PRINT "Here channel 1, count: ";C1;"    "
1170 A = (A AND &HFD00)
1180 RETURN
1190 LOCATE 0,2
1200 C2 = C2 + 1
1210 PRINT "Here channel 2, count: ";C2;"    "
1220 A = (A AND &HFB00)
1230 RETURN
1240 LOCATE 0,2
1250 C3 = C3 + 1
1260 PRINT "Here channel 3, count: ";C3;"    "
1270 A = (A AND &HF700)
1280 RETURN
1290 LOCATE 0,2
1300 C4 = C4 + 1
1310 PRINT "Here channel 4, count: ";C4;"    "
1320 A = (A AND &HEF00)
1330 RETURN
1340 LOCATE 0,2
1350 C5 = C5 + 1
1360 PRINT "Here channel 5, count: ";C5;"    "
1370 A = (A AND &HDF00)
1380 RETURN
1390 LOCATE 0,2
1400 C6 = C6 + 1
1410 PRINT "Here channel 6, count: ";C6;"    "
1420 A = (A AND &HBF00)
1430 RETURN
1440 LOCATE 0,2
1450 C7 = C7 + 1
1460 PRINT "Here channel 7, count: ";C7;"    "
1470 A = (A AND &H7F00)
1480 RETURN
1490 REM *************************
1500 REM *** Z80 ISR code      ***
1510 REM *************************
1520 DATA 3E,1B,CD,A2,00
1530 DATA 3E,59,CD,A2,00
1540 DATA 3E,24,CD,A2,00
1550 DATA 3E,20,CD,A2,00
1560 DATA 3E,20,CD,A2,00
1570 DATA 3E,20,CD,A2,00
1580 DATA 3E,20,CD,A2,00
1590 DATA 3E,20,CD,A2,00
1600 DATA 3E,20,CD,A2,00
1610 DATA 3E,20,CD,A2,00
1620 DATA 3E,20,CD,A2,00
1630 DATA 3E,20,CD,A2,00
1640 DATA 3E,20,CD,A2,00
1650 DATA 3E,20,CD,A2,00
1660 DATA 3E,20,CD,A2,00
1670 DATA 3E,20,CD,A2,00
1680 DATA 3E,20,CD,A2,00
1690 DATA 3E,1B,CD,A2,00
1700 DATA 3E,59,CD,A2,00
1710 DATA 3E,24,CD,A2,00
1720 DATA 3E,20,CD,A2,00
1730 DATA 3E,49,CD,A2,00
1740 DATA 3E,53,CD,A2,00
1750 DATA 3E,52,CD,A2,00
1760 DATA 3E,20,CD,A2,00
1770 DATA 3E,68,CD,A2,00
1780 DATA 3E,61,CD,A2,00
1790 DATA 3E,73,CD,A2,00
1800 DATA 3E,20,CD,A2,00
1810 DATA 3E,66,CD,A2,00
1820 DATA 3E,69,CD,A2,00
1830 DATA 3E,72,CD,A2,00
1840 DATA 3E,65,CD,A2,00
1850 DATA 3E,64,CD,A2,00
1860 DATA ED,4D,END
