Name      FPGA_EXP_ADR_BANKING;
Partno    xxx;
Date      01/09/23;
Revision  01;
Designer  Wiesner;
Company   None;
Assembly  None;
Location  None;
Device    g22V10;

/**  Inputs  **/

PIN 1           = clk;	    	/*      */
PIN 2           = D0;	    	/*      */
PIN 3           = D1;           	/*      */
PIN 4           = D2;           	/*      */
PIN 5           = D3;           	/*      */
PIN 6           = D4;           	/*      */
PIN 7           = D5;           	/*      */
PIN 8           = D6;           	/*      */
PIN 9           = D7;           	/*      */
PIN 10          = oe;           	/*      */
PIN 11          = A14;          	/*      */
PIN 13          = A15;

/**  Outputs  **/

PIN 23          = OD0;          	/*      */
PIN 22          = OD1;          	/*      */
PIN 21          = OD2;          	/*      */
PIN 20          = OD3;          	/*      */
PIN 19          = OD4;          	/*      */
PIN 18          = OD5;          	/*      */
PIN 17          = OD6;          	/*      */
PIN 16          = OD7;          	/*      */
PIN 15          = Y1;           	/*      */
PIN 14          = Y2;           	/*      */


Field state = [OD7..OD0];
Field in    = [D7..D0];

state.d = !in;
state.oe = oe;
state.ar = 'b'0;
state.sp = 'b'0;

Y1 = ((!A14 & !A15) & !OD0) # ((A14 & !A15) & !OD2) # ((!A14 & A15) & !OD4) # ((A14 & A15) & !OD6);
Y2 = ((!A14 & !A15) & !OD1) # ((A14 & !A15) & !OD3) # ((!A14 & A15) & !OD5) # ((A14 & A15) & !OD7); 








