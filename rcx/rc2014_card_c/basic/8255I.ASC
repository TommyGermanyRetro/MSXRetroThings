100 REM *************************
110 REM *** 8255I via XIO/RCX ***
120 REM *************************
130 REM * Uses RCX library PPI  *
140 REM * calls. Port B Mode 1  *
150 REM * strobed input - the   *
160 REM * 82C55 itself raises   *
170 REM * INTR B on PC0, fed to *
180 REM * the PIC via the XIO   *
190 REM * standard handler (no  *
200 REM * own ISR). PC4 must be *
210 REM * wired to PC2 (STB B)  *
220 REM * to trigger it.        *
230 REM *************************
240 REM * VERSION: 11/09/26     *
250 REM *************************
260 CLS
270 DEFINT A,B,G,I,J,M,N,Q,Z
280 REM *************************
290 REM *** Ask PPI IO addr   ***
300 REM *************************
310 INPUT "PPI card, IO address (0..252): ";Q
320 IF Q<0 OR Q>252 THEN PRINT "Please enter 0..252.":GOTO 310
330 REM *************************
340 REM *** Ask PIC INT chan  ***
350 REM *************************
360 INPUT "PIC INT channel (0..7): ";N
370 IF N<0 OR N>7 THEN PRINT "Please enter 0..7.":GOTO 360
380 M = 2^N
390 REM *************************
400 REM *** XIO init          ***
410 REM *************************
420 _XIO ISINIT(G)
430 IF G=1 THEN _XIO DEINIT
440 _XIO INIT(G)
450 REM *************************
460 REM *** RCX init          ***
470 REM *************************
480 _RCX ISINIT(Z)
490 IF Z=1 THEN _RCX DEINIT
500 _RCX INIT
510 REM *************************
520 REM *** PPI setup         ***
530 REM *************************
540 _PPI INIT(Q)
550 REM Group A Mode 0 (A out, C-hi out)
560 REM Group B Mode 1 (B in, INTR B on PC0)
570 _PPI CTRL(Q,&H87)
580 REM Enable INTE B (BSR on PC2)
590 _PPI SET(Q,2)
600 IC=0
610 J=0
620 REM *************************
630 REM *** Activate INT      ***
640 REM *************************
650 _XIO SET MASK(M)
660 REM *************************
670 REM *** Main loop         ***
680 REM *************************
690 CLS
700 LOCATE 0,0
710 PRINT "<SPACE> ends programme, waiting for INT"
720 _PPI A WR(Q,J)
730 _PPI A RD(Q,AR)
740 REM Toggle PC4 - wire to PC2 (STB B) to trigger
750 IF (J AND 1) = 0 THEN _PPI SET(Q,4) ELSE _PPI RESET(Q,4)
760 LOCATE 0,2
770 PRINT "OUT: ";HEX$(J);" A-RD: ";HEX$(AR);"    "
780 IF (G AND M) = M THEN GOSUB 1010
790 J=J+1
800 IF J=256 THEN J=0
810 IF INKEY$<>" " GOTO 720
820 REM *************************
830 REM *** End               ***
840 REM *************************
850 _PPI RESET(Q,2)
860 _XIO SET MASK(0)
870 _RCX DEINIT
880 _XIO DEINIT
890 LOCATE 0,5
900 PRINT "DONE"
910 END
920 REM *************************
930 REM *** On INT: read B    ***
940 REM *************************
1010 G = G - M
1020 _PPI B RD(Q,BR)
1030 IC = IC + 1
1040 LOCATE 0,3
1050 PRINT "INT fired, B-RD: ";HEX$(BR);" count: ";IC;"    "
1060 RETURN
