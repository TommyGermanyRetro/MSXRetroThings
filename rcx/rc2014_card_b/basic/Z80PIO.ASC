100 REM *************************
110 REM *** PIO via XIO/RCX   ***
105 REM *** Uses SC103 as DUT ***
120 REM *************************
130 REM * Uses RCX library PIO  *
140 REM * calls. Z80 PIO with   *
150 REM * Port A as output and  *
160 REM * Port B as input.      *
170 REM *************************
180 REM * VERSION: 09/09/26     *
190 REM *************************
200 CLS
210 DEFINT A,I,J,Q
220 REM *************************
230 REM *** Ask PIO IO addr   ***
240 REM *************************
250 INPUT "PIO card, IO address (0..252): ";Q
260 IF Q<0 OR Q>252 THEN PRINT "Please enter 0..252.":GOTO 250
270 REM *************************
280 REM *** Initialization    ***
290 REM *************************
300 _RCX ISINIT(A)
310 IF A=1 THEN _RCX DEINIT
320 _RCX INIT
330 _PIO INIT(Q)
340 REM *************************
350 REM *** PIO port direction***
360 REM *************************
370 J=0
380 REM PORT A MODE 0 (byte output)
390 _PIO A CTRL(Q,&HF)
400 REM PORT B MODE 1 (byte input)
410 _PIO B CTRL(Q,&H4F)
420 REM *************************
430 REM *** Main loop         ***
440 REM *************************
445 PRINT "<SPACE> ends programme"
450 _PIO A WR(Q,J)
460 _PIO B RD(Q,I)
465 LOCATE 0,3
470 PRINT"OUT: ",HEX$(J),"IN: ",HEX$(I),"    "
480 J=J+1
490 IF J=256 THEN J=0
495 IF INKEY$<>" " GOTO 450
500 REM *************************
510 REM *** End               ***
520 REM *************************
530 _RCX DEINIT
540 END
