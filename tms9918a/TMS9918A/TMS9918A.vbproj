  <!-- Video recording: build the native DLL with the shared VIDEOREC library (x64) and copy it next to
       the program. -->
  <Target Name="BuildVideoDll" BeforeTargets="Build">
    <MSBuild Projects="..\TMS9918AVideo\TMS9918AVideo.vcxproj" Properties="Configuration=$(Configuration);Platform=x64;BuildRoot=$(MSBuildProjectDirectory)\..\Build\" RemoveProperties="CurrentSolutionConfigurationContents;BuildingSolutionFile;SolutionDir;SolutionPath;SolutionName;SolutionFileName;SolutionExt" />
    <Copy SourceFiles="..\Build\x64\$(Configuration)\TMS9918AVideo.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>
