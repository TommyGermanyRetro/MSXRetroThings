100 REM *************************
110 REM *** PPI via XIO/RCX   ***
120 REM *************************
130 REM * Uses RCX library PPI  *
140 REM * calls. 82C55 PPI with *
150 REM * Port A as output,     *
160 REM * Port B as input and   *
170 REM * Port C bit set/reset. *
180 REM *************************
190 REM * VERSION: 11/09/26     *
200 REM *************************
210 CLS
220 DEFINT A,B,C,J,K,Q,Z
230 REM *************************
240 REM *** Ask PPI IO addr   ***
250 REM *************************
260 INPUT "PPI card, IO address (0..252): ";Q
270 IF Q<0 OR Q>252 THEN PRINT "Please enter 0..252.":GOTO 260
280 REM *************************
290 REM *** Initialization    ***
300 REM *************************
310 _RCX ISINIT(Z)
320 IF Z=1 THEN _RCX DEINIT
330 _RCX INIT
340 _PPI INIT(Q)
350 REM *************************
360 REM *** PPI port direction***
370 REM *************************
380 J=0
390 REM Mode 0, Port A out, Port B in, Port C out
400 _PPI CTRL(Q,&H82)
410 REM *************************
420 REM *** Poison RD buffers ***
430 REM *** to expose a       ***
440 REM *** missing high-byte ***
450 REM *** clear (same bug   ***
460 REM *** class as Z80PIO)  ***
470 REM *************************
480 AR=&HFF00
490 BR=&HFF00
500 CR=&HFF00
510 REM *************************
520 REM *** Main loop         ***
530 REM *************************
535 PRINT "<SPACE> ends programme"
540 _PPI A WR(Q,J)
550 _PPI A RD(Q,AR)
560 _PPI B RD(Q,BR)
570 K = J AND 7
580 IF (J AND 8) = 0 THEN _PPI SET(Q,K) ELSE _PPI RESET(Q,K)
590 _PPI C RD(Q,CR)
600 LOCATE 0,3
610 PRINT "OUT: ";HEX$(J);" A-RD: ";HEX$(AR);"    "
620 LOCATE 0,4
630 PRINT "B-RD: ";HEX$(BR);" C-RD: ";HEX$(CR);"    "
640 J=J+1
650 IF J=256 THEN J=0
660 IF INKEY$<>" " GOTO 540
670 REM *************************
680 REM *** End               ***
690 REM *************************
700 _RCX DEINIT
710 END
