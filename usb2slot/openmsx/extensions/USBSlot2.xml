<?xml version="1.0" ?>
<!DOCTYPE msxconfig SYSTEM 'msxconfig2.dtd'>
<msxconfig>
  <info>
    <name>USB Slot 2</name>
    <manufacturer>TommyGermanyRetro</manufacturer>
    <code/>
    <release_year>2026</release_year>
    <description>Slot 2 of the USB slot bridge (Teensy 4.1) with a real cartridge</description>
    <type>USB slot bridge</type>
  </info>
  <devices>
    <primary slot="any">
      <secondary slot="any">
        <USBSlot id="USB Slot 2">
          <mem base="0x0000" size="0x10000"/>
          <port>COM16</port>
          <slot>2</slot>
        </USBSlot>
      </secondary>
    </primary>
  </devices>
</msxconfig>
