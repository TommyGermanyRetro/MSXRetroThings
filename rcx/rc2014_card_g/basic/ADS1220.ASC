100 REM *************************
110 REM *** ADS1220 RCX TEST  ***
120 REM *************************
130 REM * MSXADS1220 - RCX      *
140 REM * card type G test      *
150 REM * (steps 1+2). Uses     *
160 REM * _ADS INIT/MODE/CMD/   *
170 REM * STATUS/READ/GET       *
180 REM * instead of raw _XIO   *
190 REM * OUT/INP. TEST E (NC   *
200 REM * register) is not      *
210 REM * possible here -       *
220 REM * _ADS only reaches     *
230 REM * BUS+1, no raw port    *
240 REM *************************
250 REM * VERSION: 03/09/26     *
260 REM *************************
270 CLS
280 REM *************************
290 REM *** Variables         ***
300 REM *************************
310 REM T     = measurement type 0..11 (MODE reg)
320 REM MC()  = expected mChannel per type T
330 REM NM$() = measurement type name
340 REM V,R   = CMD register write / readback value
350 REM X,W   = decoded rChannel / mCount from R
360 REM BY()  = 4 raw RESULT bytes of current reading
370 REM S,EX,DP = sign / exponent / dec.point pos.
380 REM DG()  = 6 decoded BCD mantissa digits
390 REM F!    = value assembled via native SNG POKE
400 REM FA!() = TEST A value per type, for step 2 check
410 REM G!    = ADS GET (step 2) result
420 REM D!    = |G!-FA!(T)| comparison delta
430 REM FL    = VARPTR(F!), fixed once at start
440 REM ER    = bit-level mismatch counter
450 REM A     = _RCX ISINIT flag
460 DEFINT A-Z
461 REM *************************
462 REM *** Ask ADS IO addr   ***
463 REM *************************
464 INPUT "ADS card, IO address (0..252): ";Q
465 IF Q<0 OR Q>252 THEN PRINT "Please enter 0..252.":GOTO 464
470 REM *************************
480 REM *** Setup             ***
490 REM *************************
500 DIM NM$(11):DIM MC(11):DIM BY(3):DIM DG(6):DIM FA!(11)
510 ER=0
520 F!=0
530 G!=0
540 FL=VARPTR(F!)
550 REM *************************
560 REM *** Install RCX+ADS   ***
570 REM *************************
580 _RCX ISINIT(A)
590 IF A=1 THEN _RCX DEINIT
600 _RCX INIT
610 _ADS INIT(Q)
620 RESTORE 1620
630 FOR K=0 TO 11
640  READ NM$(K),MC(K)
650 NEXT
660 REM *************************
670 REM *** Test A: readout   ***
680 REM *************************
690 REM MODE 0..11, start conversion, select
700 REM channel, full RESULT readout+decode
710 FOR T=0 TO 11
720  _ADS MODE(Q,T)
730  _ADS CMD(Q,&H80)
740  V=MC(T)
750  _ADS CMD(Q,V)
760  _ADS STATUS(Q,R)
770  X=R AND 3:W=(R\4) AND 3
780  IF X<>V OR W<>0 THEN ER=ER+1:PRINT"FAIL A cmd readback type";T
790  GOSUB 1770
800  PRINT NM$(T);" ch=";V;" by=";
810  FOR K=0 TO 3
820   IF BY(K)<16 THEN PRINT"0";
830   PRINT HEX$(BY(K));" ";
840  NEXT
850  PRINT"S=";S;" EX=";EX;" DP=";DP;" DG=";
860  FOR K=1 TO 6:PRINT DG(K);:NEXT
870  PRINT" F=";F!
880  FA!(T)=F!
890 NEXT
900 PRINT
910 REM *************************
920 REM *** Test B: cmd0 RB   ***
930 REM *************************
940 REM CMD cmd0 select-channel readback
950 FOR T=0 TO 3
960  _ADS CMD(Q,T)
970  _ADS STATUS(Q,R)
980  X=R AND 3:W=(R\4) AND 3
990  PRINT"cmd0 ch=";T;" -> rChannel=";X;" mCount=";W
1000  IF X<>T OR W<>0 THEN ER=ER+1:PRINT"FAIL B ch";T
1010 NEXT
1020 PRINT
1030 REM *************************
1040 REM *** Test C: cmd1 RB   ***
1050 REM *************************
1060 REM CMD cmd1 set-mCount readback
1070 FOR T=0 TO 3
1080  V=&H40 OR (T*4)
1090  _ADS CMD(Q,V)
1100  _ADS STATUS(Q,R)
1110  W=(R\4) AND 3
1120  PRINT"cmd1 cnt=";T;" -> mCount=";W
1130  IF W<>T THEN ER=ER+1:PRINT"FAIL C cnt";T
1140 NEXT
1150 PRINT
1160 REM *************************
1170 REM *** Test D: cmd3 no-op***
1180 REM *************************
1190 REM CMD cmd3 (reserved) is a no-op
1200 _ADS CMD(Q,1)
1210 _ADS CMD(Q,&HC0)
1220 _ADS STATUS(Q,R)
1230 X=R AND 3:W=(R\4) AND 3
1240 PRINT"cmd3 (reserved) -> rChannel=";X;" mCount=";W;" (expect 1 0)"
1250 IF X<>1 OR W<>0 THEN ER=ER+1:PRINT"FAIL D state changed"
1260 PRINT
1270 REM *************************
1280 REM *** Test F: wrap      ***
1290 REM *************************
1300 REM RESULT auto-increment + wrap x2
1310 _ADS CMD(Q,2)
1320 FOR K=0 TO 7
1330  _ADS READ(Q,R)
1340  _ADS STATUS(Q,W)
1350  W=(W\4) AND 3
1360  P=((K MOD 4)+1) MOD 4
1370  PRINT"read";K;" byte=";HEX$(R);" mCount-after=";W;" (expect";P;")"
1380  IF W<>P THEN ER=ER+1:PRINT"FAIL F wrap read";K
1390 NEXT
1400 PRINT
1410 REM *************************
1420 REM *** Test G: GET vs A  ***
1430 REM *************************
1440 REM ADS GET (step 2) vs TEST A values
1450 FOR T=0 TO 11
1460  _ADS GET(Q,T,G!)
1470  D!=ABS(G!-FA!(T))
1480  PRINT NM$(T);" GET=";G!;" (TestA=";FA!(T);")"
1490  IF D!>2.0 THEN ER=ER+1:PRINT"FAIL G tolerance type";T
1500 NEXT
1510 PRINT
1520 REM *************************
1530 REM *** Summary           ***
1540 REM *************************
1550 IF ER=0 THEN PRINT"ALL BIT-LEVEL CHECKS PASSED" ELSE PRINT ER;"CHECK(S) FAILED"
1560 _RCX DEINIT
1570 END
1580 REM *************************
1590 REM *** Measurement types ***
1600 REM *************************
1610 REM 12 measurement types, name+mChannel
1620 DATA "SE AIN0-GND",0
1630 DATA "SE AIN1-GND",1
1640 DATA "SE AIN2-GND",2
1650 DATA "SE AIN3-GND",3
1660 DATA "DE AIN0-AIN1",0
1670 DATA "DE AIN0-AIN2",0
1680 DATA "DE AIN0-AIN3",0
1690 DATA "DE AIN1-AIN2",1
1700 DATA "DE AIN1-AIN3",1
1710 DATA "DE AIN2-AIN3",2
1720 DATA "DE AIN1-AIN0",1
1730 DATA "DE AIN3-AIN2",3
1740 REM *************************
1750 REM *** Decode RESULT     ***
1760 REM *************************
1770 REM read+decode 4 RESULT bytes, POKE F!
1780 FOR K=0 TO 3
1790  _ADS READ(Q,R)
1800  BY(K)=R
1810  POKE FL+K,R
1820 NEXT
1830 S=(BY(0) AND &H80)<>0
1840 EX=BY(0) AND &H7F
1850 DP=EX-&H40
1860 DG(1)=BY(1)\16:DG(2)=BY(1) AND 15
1870 DG(3)=BY(2)\16:DG(4)=BY(2) AND 15
1880 DG(5)=BY(3)\16:DG(6)=BY(3) AND 15
1890 RETURN
