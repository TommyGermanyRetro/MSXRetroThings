100 REM *************************
110 REM *** IM2 TEST ROUTINE  ***
120 REM *** Uses SC103 as DUT ***
130 REM *************************
140 REM * Installs a Z80 ISR    *
150 REM * stub via IM2, then    *
160 REM * toggles PA0 and       *
170 REM * reports which PIO     *
180 REM * channel triggered     *
190 REM * the interrupt         *
200 REM *************************
210 REM * VERSION: 05/09/26     *
220 REM *************************
230 CLEAR 200,&HDFFF
240 DEFINT A, B, C
250 A=0:B=0:C=0
260 CLS
270 REM *************************
280 REM *** Ask PIO IO addr   ***
290 REM *************************
300 INPUT "PIO card, IO address (0..252): ";BC
310 IF BC<0 OR BC>252 THEN PRINT "Please enter 0..252.":GOTO 300
320 CA = BC + 2
330 CB = BC + 3
340 REM *************************
350 REM *** Ask INT channel   ***
360 REM *************************
370 INPUT "IM2 channel (0..7): ";BB
380 IF BB<0 OR BB>7 THEN PRINT "Please enter 0..7.":GOTO 370
390 BD = BB + 8
400 REM *************************
410 REM *** PIO via SC103     ***
420 REM *************************
430 REM PORT A as OUTPUT
440 _XIO OUT(CA,&HF)
450 REM PORT A = 0
460 _XIO OUT(BC,0)
470 REM PORT B as MODE 3 and PB0 as Input
480 _XIO OUT(CB,&HCF)
490 _XIO OUT(CB,1)
500 REM PORT B INT-Vektor 0,2,4...14
510 _XIO OUT(CB,0)
520 REM PORT B INT-Controll via PB0
530 _XIO OUT(CB,&HB7)
540 _XIO OUT(CB,254)
550 REM *************************
560 REM *** XIO init          ***
570 REM *************************
580 _XIO ISINIT(A)
590 IF A=1 THEN _XIO DEINIT
600 _XIO INIT(A)
610 PRINT "[XIO] is installed"
620 REM *************************
630 REM *** Install ISR stub  ***
640 REM *************************
650 AD = &HE000
660 RESTORE 1290
670 READ A$
680 IF A$<>"END" THEN POKE AD,VAL("&H"+A$):AD=AD+1:GOTO 670
690 _XIO SET ADDR(BD,&HE000)
700 REM *************************
710 REM *** Interrupt mask    ***
720 REM *************************
730 REM IM2 &H00xx ... &HFFxx
740 C = &HFF00
750 _XIO SET MASK(C)
760 PRINT "[XIO] mask for IM2 is set to &H";:PRINT HEX$(C)
770 REM *************************
780 REM *** Main loop         ***
790 REM *************************
800 PRINT "<SPACE> ends programme, waiting for INT"
810 IF (A AND &H100) = &H100 THEN GOSUB 1020
820 IF (A AND &H200) = &H200 THEN GOSUB 1050
830 IF (A AND &H400) = &H400 THEN GOSUB 1080
840 IF (A AND &H800) = &H800 THEN GOSUB 1110
850 IF (A AND &H1000) = &H1000 THEN GOSUB 1140
860 IF (A AND &H2000) = &H2000 THEN GOSUB 1170
870 IF (A AND &H4000) = &H4000 THEN GOSUB 1200
880 IF (A AND &H8000) = &H8000 THEN GOSUB 1230
890 REM Gebe 0/1 auf PORT A PA0 aus
900 _XIO OUT(BC,B)
910 REM Toggle Bit fuer PORT A PA0
920 IF B=0 THEN B=1 ELSE B=0
930 IF INKEY$ <>" " GOTO 810
940 REM *************************
950 REM *** End               ***
960 REM *************************
970 _XIO DEINIT
980 END
990 REM *************************
1000 REM *** Channel handlers  ***
1010 REM *************************
1020 PRINT "Here channel 0 ... <SPACE> ends programme, waiting for INT"
1030 A = (A AND &HFE00)
1040 RETURN
1050 PRINT "Here channel 1 ... <SPACE> ends programme, waiting for INT"
1060 A = (A AND &HFD00)
1070 RETURN
1080 PRINT "Here channel 2 ... <SPACE> ends programme, waiting for INT"
1090 A = (A AND &HFB00)
1100 RETURN
1110 PRINT "Here channel 3 ... <SPACE> ends programme, waiting for INT"
1120 A = (A AND &HF700)
1130 RETURN
1140 PRINT "Here channel 4 ... <SPACE> ends programme, waiting for INT"
1150 A = (A AND &HEF00)
1160 RETURN
1170 PRINT "Here channel 5 ... <SPACE> ends programme, waiting for INT"
1180 A = (A AND &HDF00)
1190 RETURN
1200 PRINT "Here channel 6 ... <SPACE> ends programme, waiting for INT"
1210 A = (A AND &HBF00)
1220 RETURN
1230 PRINT "Here channel 7 ... <SPACE> ends programme, waiting for INT"
1240 A = (A AND &H7F00)
1250 RETURN
1260 REM *************************
1270 REM *** Z80 ISR code      ***
1280 REM *************************
1290 DATA 3E,41,CD,A2,00
1300 DATA 3E,53,CD,A2,00
1310 DATA 3E,4D,CD,A2,00
1320 DATA 3E,20,CD,A2,00
1330 DATA 3E,43,CD,A2,00
1340 DATA 3E,68,CD,A2,00
1350 DATA 3E,3A,CD,A2,00
1360 DATA 3E,20,CD,A2,00
1370 DATA 3E,30,CD,A2,00
1380 DATA 3E,0A,CD,A2,00
1390 DATA 3E,0D,CD,A2,00
1400 DATA ED,4D,END
