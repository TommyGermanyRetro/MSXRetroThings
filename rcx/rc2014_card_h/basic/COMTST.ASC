100 REM *************************
110 REM *** SC725 COM test    ***
120 REM *** no handshake      ***
130 REM *************************
140 REM * Channels from DATA    *
150 REM * (now COM1: port B);   *
160 REM * COM0: (port A) and    *
170 REM * COM1: (port B), each  *
180 REM * at 1200, 9600 and     *
190 REM * 19200 baud: sends all *
200 REM * 256 byte values in    *
210 REM * 8 blocks of 32 and    *
220 REM * compares what comes   *
230 REM * back. Loopback TXD-   *
240 REM * RXD (pin 5-4) on      *
250 REM * both ports.           *
260 REM *************************
270 REM * VERSION: 07/11/26     *
280 REM *************************
290 CLEAR 1000
300 DEFINT A-Z
310 REM all variables before _XIO INIT
320 A=0:B=0:C=0:D=0:E=0:F=0:H=0:I=0:K=0:N=0:Q=0:R=0:NC=0
330 OK=0:NT=0:D$="":P$="":R$=""
340 DIM A$(7)
350 REM *************************
360 REM *** XIO, RCX, COM     ***
370 REM *************************
380 _XIO ISINIT(D)
390 IF D=1 THEN _XIO DEINIT
400 _XIO INIT(A)
410 _RCX ISINIT(D)
420 IF D=1 THEN _RCX DEINIT
430 _RCX INIT
440 Q=&H80
450 _COM INIT(Q)
460 REM *************************
470 REM *** Test data         ***
480 REM *************************
490 REM after the INITs: they clear the
500 REM string space
510 FOR K=0 TO 7:A$(K)=""
520 FOR I=0 TO 31:A$(K)=A$(K)+CHR$(K*32+I):NEXT I
530 NEXT K
540 ON ERROR GOTO 1070
550 CLS
560 PRINT "SC725 COM test, no handshake"
570 PRINT
580 REM *************************
590 REM *** Channels, rates   ***
600 REM *************************
610 RESTORE 1030
620 READ NC
630 FOR H=1 TO NC
640 RESTORE 1030
650 FOR I=0 TO H:READ C:NEXT I
660 RESTORE 980
670 FOR R=1 TO 3
680 READ B
690 P$=CHR$(48+C)+":8N1NNNNN"
700 D$="COM"+CHR$(48+C)+":"
710 E=0:F=0
720 CALL COMINI(P$,B,,2)
730 OPEN D$ AS #1
740 FOR K=0 TO 7
750 PRINT #1,A$(K);
760 R$=INPUT$(32,#1)
770 IF R$<>A$(K) THEN F=F+1
780 NEXT K
790 N=LOC(1)
800 CLOSE #1
810 PRINT D$;B;"baud 256 bytes";
820 NT=NT+1
830 IF E=0 AND F=0 AND N=0 THEN PRINT " PASS":OK=OK+1 ELSE PRINT " FAIL";E;F
840 NEXT R
850 NEXT H
860 REM *************************
870 REM *** Summary           ***
880 REM *************************
890 ON ERROR GOTO 0
900 _RCX DEINIT
910 _XIO DEINIT
920 PRINT
930 PRINT OK;"of";NT;"PASS"
940 END
950 REM *************************
960 REM *** Baud rates        ***
970 REM *************************
980 DATA 1200,9600,19200
990 REM *************************
1000 REM *** Channels          ***
1010 REM *************************
1020 REM count, channels (0 = A, 1 = B)
1030 DATA 1,1
1040 REM *************************
1050 REM *** Error handler     ***
1060 REM *************************
1070 E=ERR:RESUME NEXT
