100 REM *************************
110 REM *** SC725 COM test    ***
120 REM *** CTS-RTS handshake ***
130 REM *************************
140 REM * Channels from DATA    *
150 REM * (now COM1: port B);   *
160 REM * COM0: (port A) and    *
170 REM * COM1: (port B), 9600  *
180 REM * baud, CTS-RTS: sends  *
190 REM * 200 characters, no    *
200 REM * reading. RTS stops    *
210 REM * the sender before     *
220 REM * the 123 character     *
230 REM * buffer overflows;     *
240 REM * then reads and sends  *
250 REM * the rest. Loopback    *
260 REM * TXD-RXD (5-4) and     *
270 REM * RTS-CTS (2-6) on      *
280 REM * both ports.           *
290 REM *************************
300 REM * VERSION: 07/11/26     *
310 REM *************************
320 CLEAR 1000
330 DEFINT A-Z
340 REM all variables before _XIO INIT
350 A=0:C=0:D=0:E=0:H=0:I=0:L=0:N=0:Q=0:S=0:NC=0
360 OK=0:NT=0:D$="":P$="":R$="":T$=""
370 REM *************************
380 REM *** XIO, RCX, COM     ***
390 REM *************************
400 _XIO ISINIT(D)
410 IF D=1 THEN _XIO DEINIT
420 _XIO INIT(A)
430 _RCX ISINIT(D)
440 IF D=1 THEN _RCX DEINIT
450 _RCX INIT
460 Q=&H80
470 _COM INIT(Q)
480 REM *************************
490 REM *** Test data         ***
500 REM *************************
510 REM after the INITs: they clear the
520 REM string space
530 FOR I=0 TO 199:T$=T$+CHR$(65+I MOD 26):NEXT I
540 ON ERROR GOTO 1080
550 CLS
560 PRINT "SC725 COM test, CTS-RTS"
570 PRINT
580 REM *************************
590 REM *** Channels          ***
600 REM *************************
610 RESTORE 1040
620 READ NC
630 FOR H=1 TO NC
640 RESTORE 1040
650 FOR I=0 TO H:READ C:NEXT I
660 P$=CHR$(48+C)+":8N1NHNNN"
670 D$="COM"+CHR$(48+C)+":"
680 CALL COMINI(P$,9600,,1)
690 OPEN D$ AS #1
700 REM send until RTS stops the sender
710 E=0:N=0
720 PRINT #1,MID$(T$,N+1,1);
730 IF E=0 THEN N=N+1:IF N<200 THEN GOTO 720
740 L=LOC(1)
750 R$=INPUT$(L,#1)
760 IF C=0 THEN CALL COMSTAT("0:",S) ELSE CALL COMSTAT("1:",S)
770 PRINT D$;" stop after";N;"LOC";L;
780 NT=NT+1
790 IF E=19 AND N=L AND L<123 AND R$=LEFT$(T$,N) AND S>=0 THEN PRINT " PASS":OK=OK+1 ELSE PRINT " FAIL";E
800 REM send and read the rest
810 E=0:R$=""
820 FOR I=N+1 TO 200
830 PRINT #1,MID$(T$,I,1);
840 R$=R$+INPUT$(1,#1)
850 NEXT I
860 PRINT D$;" rest";200-N;"chars";
870 NT=NT+1
880 IF E=0 AND R$=MID$(T$,N+1) THEN PRINT " PASS":OK=OK+1 ELSE PRINT " FAIL";E
890 CLOSE #1
900 NEXT H
910 REM *************************
920 REM *** Summary           ***
930 REM *************************
940 ON ERROR GOTO 0
950 _RCX DEINIT
960 _XIO DEINIT
970 PRINT
980 PRINT OK;"of";NT;"PASS"
990 END
1000 REM *************************
1010 REM *** Channels          ***
1020 REM *************************
1030 REM count, channels (0 = A, 1 = B)
1040 DATA 1,1
1050 REM *************************
1060 REM *** Error handler     ***
1070 REM *************************
1080 E=ERR:RESUME NEXT
