100 REM *************************
110 REM *** MCP4822 XIO TEST  ***
120 REM *************************
130 REM * RC2014 card I with 2x *
140 REM * MCP4822 (4 channels   *
150 REM * 12 bit D/A). Native   *
160 REM * _XIO OUT/INP only.    *
170 REM * Checks the register   *
180 REM * readback, sets        *
190 REM * synchronous test      *
200 REM * voltages, gain x1,    *
210 REM * shutdown and then     *
220 REM * single channels by    *
230 REM * keyboard input.       *
240 REM * Base +0 SELECT        *
250 REM * +1 CONFIG             *
260 REM * +2 VALUE LOW          *
270 REM * +3 VALUE HIGH         *
280 REM *************************
290 REM * VERSION: 02/11/26     *
300 REM *************************
310 CLS
320 REM *************************
330 REM *** Variables         ***
340 REM *************************
350 REM Q     = card IO address (SELECT)
360 REM Q1-Q3 = CONFIG / VALUE LOW / VALUE HIGH
370 REM K     = channel 0..3
380 REM C     = configuration 0..3
390 REM V     = value 0..4095 (gain x2 = mV)
400 REM L,H   = value low / high byte
410 REM R     = readback value
420 REM I     = loop counter
430 REM ER    = readback mismatch counter
440 REM A$    = key press
450 DEFINT A-Z
460 REM *************************
470 REM *** Ask card IO addr  ***
480 REM *************************
490 INPUT "MCP4822 card, IO address (0..252): ";Q
500 IF Q<0 OR Q>252 OR (Q AND 3)<>0 THEN PRINT "Please enter 0..252, multiple of 4.":GOTO 490
510 REM *************************
520 REM *** Setup             ***
530 REM *************************
540 Q1=Q+1:Q2=Q+2:Q3=Q+3
550 ER=0:R=0:L=0:H=0
560 REM *************************
570 REM *** Test A: config    ***
580 REM *************************
590 REM SELECT + CONFIG readback, all configs
600 FOR K=0 TO 3
610  _XIO OUT(Q,K)
620  FOR C=0 TO 3
630   _XIO OUT(Q1,C)
640   _XIO INP(Q1,R)
650   IF R<>C THEN ER=ER+1:PRINT"FAIL A config ch";K;" cfg";C;" read";R
660   _XIO INP(Q,R)
670   IF R<>(K OR C*16) THEN ER=ER+1:PRINT"FAIL A select ch";K;" cfg";C;" read";R
680  NEXT
690  _XIO OUT(Q1,1)
700 NEXT
710 PRINT"Test A (config readback) done"
720 REM *************************
730 REM *** Test B: value     ***
740 REM *************************
750 REM VALUE LOW/HIGH readback 0..4095,
760 REM odd steps with HOLD (bit 6 not read)
770 FOR K=0 TO 3
780  _XIO OUT(Q,K)
790  FOR I=0 TO 3
800   V=I*1365
810   L=V AND 255:H=V\256
820   IF I AND 1 THEN H=H OR 64
830   _XIO OUT(Q2,L)
840   _XIO OUT(Q3,H)
850   _XIO INP(Q2,L)
860   _XIO INP(Q3,H)
870   IF L+H*256<>V THEN ER=ER+1:PRINT"FAIL B ch";K;" value";V;" read";L+H*256
880  NEXT
890 NEXT
900 PRINT"Test B (value readback) done"
910 PRINT
920 REM *************************
930 REM *** Test C: sync      ***
940 REM *************************
950 REM all 0 V, then 1/2/3/4 V with HOLD,
960 REM channel 3 again without HOLD = /LDAC
970 FOR K=0 TO 3
980  _XIO OUT(Q,K)
990  _XIO OUT(Q2,0)
1000  _XIO OUT(Q3,0)
1010 NEXT
1020 FOR K=0 TO 3
1030  V=(K+1)*1000
1040  _XIO OUT(Q,K)
1050  L=V AND 255:H=(V\256) OR 64
1060  _XIO OUT(Q2,L)
1070  _XIO OUT(Q3,H)
1080 NEXT
1090 PRINT"X101.2-5 must still be 0 V (HOLD)."
1100 PRINT"Press a key.":A$=INPUT$(1)
1110 _XIO OUT(Q,3)
1120 V=4000:L=V AND 255:H=V\256
1130 _XIO OUT(Q2,L)
1140 _XIO OUT(Q3,H)
1150 PRINT"X101.2-5 now 1.000/2.000/3.000/4.000 V."
1160 PRINT"Press a key.":A$=INPUT$(1)
1170 PRINT
1180 REM *************************
1190 REM *** Test D: gain+shdn ***
1200 REM *************************
1210 REM channel 0 (1000) gain x1 -> 0.5 V,
1220 REM shutdown -> 0 V, back to gain x2
1230 _XIO OUT(Q,0)
1240 _XIO OUT(Q1,0)
1250 PRINT"Gain x1: X101.2 must be 0.500 V."
1260 PRINT"Press a key.":A$=INPUT$(1)
1270 _XIO OUT(Q1,3)
1280 PRINT"Shutdown: X101.2 must be 0 V."
1290 PRINT"Press a key.":A$=INPUT$(1)
1300 _XIO OUT(Q1,1)
1310 PRINT"Gain x2: X101.2 must be 1.000 V again."
1320 PRINT
1330 REM *************************
1340 REM *** Summary           ***
1350 REM *************************
1360 IF ER=0 THEN PRINT"ALL READBACK CHECKS PASSED" ELSE PRINT ER;"READBACK ERRORS"
1370 PRINT
1380 REM *************************
1390 REM *** Manual output     ***
1400 REM *************************
1410 INPUT "Channel 0..3 (9 = end)";K
1420 IF K=9 THEN END
1430 IF K<0 OR K>3 THEN 1410
1440 INPUT "Value 0..4095 (mV)";V
1450 IF V<0 OR V>4095 THEN 1440
1460 _XIO OUT(Q,K)
1470 L=V AND 255:H=V\256
1480 _XIO OUT(Q2,L)
1490 _XIO OUT(Q3,H)
1500 GOTO 1410
